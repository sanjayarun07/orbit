# Any LiteLLM-compatible model identifier supported by DSPy.
MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=

# LLM-hop resilience. Explicit per-request timeout (litellm otherwise waits up to
# 600s on a wedged call); LLM_NUM_RETRIES is litellm's own backoff against the
# SAME model; LLM_FALLBACK_MODEL is tried once when the primary exhausts its
# retries with a transient/provider error -- set it to a DIFFERENT provider you
# have keys for so a full primary outage still answers (empty = disabled).
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_NUM_RETRIES=2
LLM_FALLBACK_MODEL=

# Intent semantics (uses the existing OpenAI key); cosine is not a probability.
INTENT_EMBEDDING_ENABLED=true
INTENT_EMBEDDING_MODEL=text-embedding-3-small
INTENT_EMBEDDING_THRESHOLD=0.78
INTENT_EMBEDDING_MARGIN=0.08
INTENT_EMBEDDING_TIMEOUT_SECONDS=8
INTENT_EMBEDDING_CACHE_ENTRIES=512
INTENT_MODEL_CONFIDENCE_THRESHOLD=0.90

# Per-capability tool-selection semantic fallback -- a second chance for a
# description-bearing ProviderTool whose regex `matches` gate returned False,
# not the same thing as the intent-classification settings above. Threshold
# is a placeholder pending live calibration; see the tool-retrieval plan.
TOOL_EMBEDDING_ENABLED=true
TOOL_EMBEDDING_MODEL=text-embedding-3-small
TOOL_EMBEDDING_THRESHOLD=0.45
TOOL_EMBEDDING_TIMEOUT_SECONDS=8
TOOL_EMBEDDING_CACHE_ENTRIES=512

# Optional: preferred live retrieval provider. Enables web_search, fetch_url,
# people_search and finance_search through Perplexity Agent API. Sandbox is not used.
PERPLEXITY_API_KEY=
PERPLEXITY_AGENT_URL=https://api.perplexity.ai/v1/agent
PERPLEXITY_MODEL=perplexity/sonar
PERPLEXITY_TIMEOUT_SECONDS=45
PERPLEXITY_CACHE_TTL_SECONDS=60
PERPLEXITY_CACHE_MAX_ENTRIES=512
PERPLEXITY_WEB_SEARCH_COST_USD=0.005
PERPLEXITY_FETCH_URL_COST_USD=0.0005
PERPLEXITY_PEOPLE_SEARCH_COST_USD=0.005
PERPLEXITY_FINANCE_SEARCH_COST_USD=0.005
PERPLEXITY_REQUESTS_PER_MINUTE=60
OPENAI_WEB_SEARCH_COST_USD=0.01
OPENAI_WEB_SEARCH_REQUESTS_PER_MINUTE=60
OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini

# Provider router scoring, semantic cache and circuit breaker.
PROVIDER_COST_WEIGHT=100
PROVIDER_HEALTH_WEIGHT=4
PROVIDER_SEMANTIC_CACHE_THRESHOLD=0.92
PROVIDER_CACHE_MAX_ENTRIES=1024
PROVIDER_REQUEST_TIMEOUT_SECONDS=45
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60

# Optional market-data providers. Keep cost values aligned with your plan.
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
BIRDEYE_REQUESTS_PER_MINUTE=60
BIRDEYE_REQUEST_COST_USD=0
MOBULA_API_KEY=
MOBULA_BASE_URL=https://api.mobula.io/api/2
MOBULA_REQUESTS_PER_MINUTE=60
MOBULA_REQUEST_COST_USD=0
BITQUERY_API_KEY=
BITQUERY_GRAPHQL_URL=https://streaming.bitquery.io/eap
BITQUERY_REQUESTS_PER_MINUTE=30
# Estimated from Bitquery's published points pricing (5 points/cube on
# dataset:realtime, Personal plan $49/mo for 100k points) -- recalibrate
# against your actual plan/invoices.
BITQUERY_REQUEST_COST_USD=0.00245

# Identity/metadata. CoinGecko works without a key at public limits;
# CoinMarketCap is the credentialed fallback.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINMARKETCAP_API_KEY=
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com

# Token-security primary and fallback.
GOPLUS_ACCESS_TOKEN=
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1
HONEYPOT_BASE_URL=https://api.honeypot.is/v2

# DeFi and wallet activity providers.
DEFILLAMA_BASE_URL=https://api.llama.fi
GOLDRUSH_API_KEY=
GOLDRUSH_BASE_URL=https://api.covalenthq.com/v1
HELIUS_API_KEY=

# Required for admin provider-policy APIs. The UI stores it in sessionStorage only.
ADMIN_API_KEY=
PROVIDER_OVERRIDES_PATH=provider-overrides.json

# Optional Privy embedded-wallet onboarding. These two values are public browser
# identifiers from Privy Dashboard > Settings > Clients. Do not put app secrets
# or authorization-key private keys in browser configuration.
PRIVY_APP_ID=<your-privy-app-id>
PRIVY_CLIENT_ID=<your-privy-client-id>
# Optional external EVM-wallet fallback (public Reown project identifier).
REOWN_PROJECT_ID=
# JSON map of chain IDs to trusted EVM RPC endpoints used for Coinbase Smart
# Wallet login signature verification (ERC-1271/ERC-6492).
EVM_AUTH_RPC_URLS={"1":"https://ethereum-rpc.publicnode.com","10":"https://mainnet.optimism.io","56":"https://bsc-dataseed.binance.org","137":"https://polygon-bor-rpc.publicnode.com","8453":"https://mainnet.base.org","42161":"https://arb1.arbitrum.io/rpc","43114":"https://api.avax.network/ext/bc/C/rpc"}
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_BASE_URL=https://api.jup.ag/swap/v1
JUPITER_API_ROOT=https://api.jup.ag
JUPITER_API_KEY=
RELAY_API_KEY=

# Quote-only cross-chain fallback. The API key is optional at LI.FI's public
# rate limit. Quotes still require explicit wallet approval before execution.
LIFI_ENABLED=true
LIFI_API_KEY=
LIFI_BASE_URL=https://li.quest/v1

# A base58 encoded Solana keypair. Leave blank until ready for controlled testing.
SOLANA_PRIVATE_KEY=
LIVE_TRADING=false
MAX_TRADE_USD=25
MAX_SLIPPAGE_BPS=100
MAX_PRICE_IMPACT_PCT=5
PLAN_TTL_SECONDS=120
MEMORY_PLAN_MAX_ENTRIES=1000

# Optional: enables MCP servers declared in mcp.json (e.g. Nansen). Get a key
# at https://app.nansen.ai/api?tab=api. Leave blank to keep Nansen tools inactive.
NANSEN_API_KEY=

# Optional: persistent memory/state. Unset or unreachable falls back to in-memory.
# docker-compose.yml overrides DATABASE_URL/REDIS_URL to its own postgres/redis
# services and forces ALLOW_MEMORY_FALLBACK=false.
DATABASE_URL=postgresql://localhost/solana_dspy_poc
REDIS_URL=redis://localhost:6379/0
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
ALLOW_MEMORY_FALLBACK=true

# Container runtime (Dockerfile / docker-compose.yml). POSTGRES_PASSWORD is
# required by compose; the rest have safe defaults. FORWARDED_ALLOW_IPS is the
# uvicorn-level trust list for X-Forwarded-* (set to your reverse proxy's IP).
POSTGRES_PASSWORD=
UVICORN_WORKERS=1
FORWARDED_ALLOW_IPS=127.0.0.1
GRACEFUL_SHUTDOWN_SECONDS=30
LOG_LEVEL=INFO

# Optional analytics store. The app remains operational when unset.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true
DUNE_API_KEY=
DUNE_BASE_URL=https://api.dune.com/api/v1
DUNE_REQUESTS_PER_MINUTE=10
DUNE_QUERY_PERFORMANCE=small
DUNE_POLL_INTERVAL_SECONDS=2.0
DUNE_POLL_TIMEOUT_SECONDS=120.0
WASH_TRADING_ROUND_TRIP_MAX_GAP_SECONDS=30.0
WASH_TRADING_ROUND_TRIP_SIZE_TOLERANCE_PCT=0.05

# RootData project/VC/people directory search. RootData charges 20 credits for
# each ID-map refresh, so maps are cached for 12 hours and filtered locally.
ROOTDATA_API_KEY=
ROOTDATA_BASE_URL=https://api.rootdata.com/open
ROOTDATA_REQUESTS_PER_MINUTE=60
ROOTDATA_MAP_CACHE_TTL_SECONDS=43200
ROOTDATA_REQUEST_COST_USD=0

# Capacity / token controls. Tune these against provider quotas and instance size.
MAX_CONCURRENT_CHAT_REQUESTS=32
MAX_CONCURRENT_LLM_REQUESTS=16
CHAT_REQUESTS_PER_MINUTE=60
CHAT_EXECUTION_TIMEOUT_SECONDS=120
REQUEST_QUEUE_TIMEOUT_SECONDS=10
RPC_REQUESTS_PER_MINUTE=120
RPC_MAX_BATCH_SIZE=10
RPC_MAX_BODY_BYTES=65536
# Comma-separated immediate proxy IPs allowed to supply X-Forwarded-For.
TRUSTED_PROXY_HOSTS=
MAX_CONTEXT_MESSAGES=8
MAX_CONTEXT_CHARS=6000
MAX_MCP_TOOLS_PER_REQUEST=5
MAX_CONCURRENT_MCP_CALLS=8
MCP_CONNECTIONS_PER_SERVER=2
MCP_CALL_TIMEOUT_SECONDS=20
MCP_RESULT_MAX_CHARS=12000
MCP_CACHE_TTL_SECONDS=60
MCP_CACHE_MAX_ENTRIES=512
# Per-tool cache TTL overrides (raw MCP tool name -> seconds) for
# slow-changing data. JSON object; anything not listed keeps the default above.
MCP_TOOL_CACHE_TTL_SECONDS={"address_labels":3600,"address_portfolio":300,"address_transactions":120,"token_current_top_holders":300,"token_quant_scores":300,"token_info":300}
MCP_ENV_ALLOWLIST=NANSEN_API_KEY
# Per-chat-turn cap on external provider/MCP calls and tracked cost.
MAX_EXTERNAL_CALLS_PER_TURN=12
MAX_PAID_DATA_COST_USD_PER_TURN=0.50
MEMORY_SESSION_MAX_ENTRIES=1000
# Keep true for the tool activity cards; set false in deployments that hide traces.
EXPOSE_TOOL_TRAJECTORY=false

# Optional: request tracing. Both keys required to enable (get them at
# https://cloud.langfuse.com). Leave blank to disable tracing entirely.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
