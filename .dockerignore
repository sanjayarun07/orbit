# Secrets and local state never enter the build context.
.env
.env.*
!.env.example
provider-overrides.json

# Local toolchains and caches
.venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.git/
.github/
.githooks/
.claude/
.vscode/
.DS_Store

# Investigation snapshots, eval fixtures and docs are not runtime inputs.
data/
docs/
evals/
tests/
scripts/
# ...except the operator scripts the runbook runs inside the image.
!scripts/kb_ingest.py
!scripts/routing_eval/
scripts/routing_eval/__pycache__/
scripts/routing_eval/runs/
scripts/routing_eval/results*.json
scripts/routing_eval/candidates.json
scripts/routing_eval/to_label.json
*.md
!README.md
!skills/**/SKILL.md

# Built bundles are produced in the image's node stage from web/*.ts.
app/static/*.js
