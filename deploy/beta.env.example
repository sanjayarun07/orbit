# Closed-beta deployment: free plans, no payments, unlisted open sign-up,
# execution on with signing only in the user's own wallet. Copy to .env on
# the host and fill every <...>. The startup audit refuses to boot a
# production instance with an unsafe value, and names every problem at once.
#
#   cp deploy/beta.env.example .env && $EDITOR .env
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#   curl -s https://$ORBIT_DOMAIN/readyz | jq .

# ---- identity of this deployment
ENVIRONMENT=production
PRODUCT_NAME=Dopamint
ORBIT_DOMAIN=<beta.yourdomain.com>          # Caddy obtains the certificate; DNS must point here first
PUBLIC_BASE_URL=https://<beta.yourdomain.com>
ORBIT_IMAGE_TAG=main                        # pin to sha-<commit> to roll back

# ---- the beta itself
CLOSED_BETA=true                            # no payments; every signed-in account on the Beta plan
CLOSED_BETA_MONTHLY_CREDITS=5000

# ---- execution: the user's own wallet signs; the server never holds a key
DEPLOYMENT_MODE=execution                   # swaps on, signed in the user's wallet. To disable: research AND LIVE_TRADING=false
                                            # (research with LIVE_TRADING=true is a contradiction the audit refuses to boot)
LIVE_TRADING=true                           # must agree with DEPLOYMENT_MODE or startup refuses
ALLOW_CUSTODIAL_SIGNING=false
# SOLANA_PRIVATE_KEY must be ABSENT: a key with custody off is a fatal audit finding by design
MAX_TRADE_USD=20                            # beta cap per trade (user decision 2026-09-17); raise deliberately, not by default

# ---- storage (the compose file wires DATABASE_URL and REDIS_URL from these)
POSTGRES_PASSWORD=                          # generate: openssl rand -hex 32
ALLOW_MEMORY_FALLBACK=false

# ---- sign-in: magic links by email; the link is never returned in a response
RESEND_API_KEY=                             # your Resend key
EMAIL_FROM=Dopamint <hello@yourdomain.com>
DEV_EXPOSE_MAGIC_LINKS=false

# ---- operator access
ADMIN_API_KEY=                              # generate: openssl rand -hex 32; admin pages; never typed into a shared browser
MCP_API_KEY=                                # generate: openssl rand -hex 32; the MCP endpoint refuses without it

# ---- routing backend (A/B): the speech model on one domain, Jev on another.
# speech_model (default) | jev | jev_fallthrough (Jev when >=0.9 confident, else the speech model)
# A production instance on a jev backend without TYPESAFE_API_KEY refuses to boot.
ROUTING_BACKEND=speech_model
TYPESAFE_API_KEY=                           # required for jev / jev_fallthrough

# ---- models
MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=                             # your OpenAI key
# INTENT_MODEL, LLM_FALLBACK_MODEL, SYNTHESIS_MODEL: leave unset (gpt-4.1-mini on every seam)

# ---- data providers (each unset provider simply stays out of routing)
PERPLEXITY_API_KEY=                         # provider key, or leave blank to keep it out of routing
COINGECKO_API_KEY=                          # provider key, or leave blank to keep it out of routing
BIRDEYE_API_KEY=                            # provider key, or leave blank to keep it out of routing
GOLDRUSH_API_KEY=                           # provider key, or leave blank to keep it out of routing
HELIUS_API_KEY=                             # provider key, or leave blank to keep it out of routing
BITQUERY_API_KEY=                           # provider key, or leave blank to keep it out of routing
GOPLUS_ACCESS_TOKEN=                        # provider key, or leave blank to keep it out of routing
NANSEN_API_KEY=                             # provider key, or leave blank to keep it out of routing
ROOTDATA_API_KEY=                           # provider key, or leave blank to keep it out of routing
JUPITER_API_KEY=                            # provider key, or leave blank to keep it out of routing
RELAY_API_KEY=                              # provider key, or leave blank to keep it out of routing

# ---- knowledge base: loaded once by hand from the host (see the runbook); the background
# refresher stays off (user decision 2026-09-17). Re-run the bulk load to refresh.
KNOWLEDGE_INGEST_ENABLED=false
KNOWLEDGE_EMBEDDING_PROVIDER=openai

# ---- guardrails that stay on for an unlisted, open sign-up
CHAT_REQUESTS_PER_MINUTE=10
MAX_PAID_DATA_COST_USD_PER_TURN=0.25
UVICORN_WORKERS=2
LOG_LEVEL=INFO
