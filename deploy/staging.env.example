# Staging deployment: the production stack on its own host, domain and
# stores, held to the same startup gates (ENVIRONMENT=staging is audited
# exactly like production), with swaps OFF until they are rehearsed here.
# Copy to .env on the staging host and fill every <...>; run the preflight
# before bringing it up.
#
#   cp deploy/staging.env.example .env && $EDITOR .env
#   python scripts/preflight.py .env
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#   curl -s https://$ORBIT_DOMAIN/readyz | jq .
#
# It defines the same keys as deploy/beta.env.example (a test keeps them in
# step); only the values marked "staging:" differ.

# ---- identity of this deployment
ENVIRONMENT=staging                         # staging: audited like production; shows as staging in logs and /readyz
PRODUCT_NAME=Dopamint
ORBIT_DOMAIN=<staging.yourdomain.com>       # staging: its own hostname; Caddy obtains the certificate; DNS must point here first
PUBLIC_BASE_URL=https://<staging.yourdomain.com>
ORBIT_IMAGE_TAG=sha-<short commit>          # staging: always a pinned commit, the 7-char sha CI tags (e.g. sha-59e52a8); never a moving tag

# ---- the beta itself
CLOSED_BETA=true                            # no payments; every signed-in account on the Beta plan
CLOSED_BETA_MONTHLY_CREDITS=5000

# ---- execution: the user's own wallet signs; the server never holds a key
DEPLOYMENT_MODE=research                    # staging: swaps OFF until wallet, RPC and provider checks pass here; then execution + LIVE_TRADING=true
                                            # (research with LIVE_TRADING=true is a contradiction the audit refuses to boot)
LIVE_TRADING=false                          # must agree with DEPLOYMENT_MODE or startup refuses
ALLOW_CUSTODIAL_SIGNING=false
# SOLANA_PRIVATE_KEY must be ABSENT: a key with custody off is a fatal audit finding by design
MAX_TRADE_USD=5                             # staging: a rehearsal cap once execution is switched on; the beta runs at 20

# ---- storage. Local stack (docker-compose.yml + docker-compose.prod.yml): the compose
# file runs Postgres and Redis and wires their URLs from this password.
POSTGRES_PASSWORD=                          # generate: openssl rand -hex 32
ALLOW_MEMORY_FALLBACK=false
# Managed stores (docker-compose.managed.yml, used alone): set both URLs to the private
# addresses of Cloud SQL and Memorystore, leave POSTGRES_PASSWORD blank. See docs/deploy-gcp.md.
DATABASE_URL=                               # e.g. postgresql://orbit:<password>@10.x.x.x:5432/orbit?sslmode=require
REDIS_URL=                                  # e.g. redis://10.y.y.y:6379/0

# ---- sign-in: magic links by email; the link is never returned in a response
RESEND_API_KEY=                             # your Resend key
EMAIL_FROM=Dopamint staging <hello@yourdomain.com>   # staging: say so in the subject line of every magic link
DEV_EXPOSE_MAGIC_LINKS=false

# ---- operator access
ADMIN_API_KEY=                              # generate: openssl rand -hex 32; admin pages; never typed into a shared browser
MCP_API_KEY=                                # generate: openssl rand -hex 32; the MCP endpoint refuses without it

# ---- routing backend (A/B): the speech model on one domain, Jev on another.
# speech_model (default) | jev | jev_fallthrough (Jev when >=0.9 confident, else the speech model)
# A production instance on a jev backend without TYPESAFE_API_KEY refuses to boot.
ROUTING_BACKEND=speech_model
TYPESAFE_API_KEY=                           # required for jev / jev_fallthrough

# ---- models
MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=                             # your OpenAI key
# INTENT_MODEL, LLM_FALLBACK_MODEL, SYNTHESIS_MODEL: leave unset (gpt-4.1-mini on every seam)

# ---- data providers (each unset provider simply stays out of routing)
MOBULA_API_KEY=                             # first source for wallets, portfolios, meme forensics and the holder ledger (user decision 2026-09-18)
PERPLEXITY_API_KEY=                         # provider key, or leave blank to keep it out of routing
COINGECKO_API_KEY=                          # provider key, or leave blank to keep it out of routing
BIRDEYE_API_KEY=                            # provider key, or leave blank to keep it out of routing
GOLDRUSH_API_KEY=                           # provider key, or leave blank to keep it out of routing
HELIUS_API_KEY=                             # provider key, or leave blank to keep it out of routing
BITQUERY_API_KEY=                           # provider key, or leave blank to keep it out of routing
GOPLUS_ACCESS_TOKEN=                        # provider key, or leave blank to keep it out of routing
NANSEN_API_KEY=                             # provider key, or leave blank to keep it out of routing
ROOTDATA_API_KEY=                           # provider key, or leave blank to keep it out of routing
JUPITER_API_KEY=                            # provider key, or leave blank to keep it out of routing
RELAY_API_KEY=                              # provider key, or leave blank to keep it out of routing
SOLANA_RPC_URL=                             # a paid RPC (Helius/Triton/QuickNode); the public mainnet endpoint rate-limits a real user base
# EVM_AUTH_RPC_URLS: JSON map of chain id -> RPC for wallet sign-in signature checks; the defaults are public endpoints

# ---- crowd and sentiment (2026-09-21/22)
TWITTERAPI_IO_KEY=                          # X sentiment analyst: tweets by TwitterAPI.io; unset = the social card falls back to web research
TYPESAFE_API_KEY=                           # Jev: the typed sentiment judge (and the jev routing backend above); unset = sentiment judged by the speech model
REDDIT_CLIENT_ID=                           # Reddit script app (client-credentials); both unset = no Reddit card
REDDIT_CLIENT_SECRET=
POLYMARKET_ENABLED=true                     # keyless; unreachable networks show as a degraded /readyz check, never a failed one

# ---- browser wallets (public identifiers; the browser receives them through /config/public)
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
REOWN_PROJECT_ID=

# ---- the meme holder snapshot ledger (2026-09-21): one leader per deployment through a Redis lease;
# draws a quarter of the Mobula minute rate in the background lane
HOLDER_SNAPSHOTS_ENABLED=true
MOBULA_REQUESTS_PER_MINUTE=60               # your Mobula plan's sustained rate; shared across workers through Redis (MOBULA_SHARED_LIMIT=true)

# ---- knowledge base: loaded once by hand from the host (see the runbook); the background
# refresher stays off (user decision 2026-09-17). Re-run the bulk load to refresh.
KNOWLEDGE_INGEST_ENABLED=false
KNOWLEDGE_EMBEDDING_PROVIDER=openai

# ---- guardrails that stay on for an unlisted, open sign-up
CHAT_REQUESTS_PER_MINUTE=10
MAX_PAID_DATA_COST_USD_PER_TURN=0.25
UVICORN_WORKERS=2                           # the app reads the same value to split per-process budgets; keep the two equal
LOG_LEVEL=INFO

# TradingView on the user's own account (Settings > Connections). Needs PUBLIC_BASE_URL (OAuth redirect). Set false to hide the feature.
TRADINGVIEW_ENABLED=true
