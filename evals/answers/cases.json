        {"check": "min_rows", "pattern": "^\\|\\s*\\d+\\s*\\|.*\\d+\\.\\d+%", "count": 5},
        {"check": "regex", "pattern": "top 10 .{0,40}\\d+\\.\\d+% of supply"},
        {"check": "contains_any", "values": ["pools, exchanges and burn addresses included", "Mobula's own exclusions", "not necessarily distinct owners"]},
        {"check": "envelope", "tool": "mobula_token_holders", "status": ["complete", "partial"]},
        {"check": "gaps_disclosed"}
