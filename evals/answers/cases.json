{
  "note": "Answer requirements, judged against pinned snapshots (evals/answers/snapshots/<id>.json). Dates are relative to each snapshot's captured_at. Refresh a snapshot with: python scripts/answer_eval.py capture --case <id>.",
  "cases": [
